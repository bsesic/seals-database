# /etc/logrotate.d/seals-database
#
# Rotates the app logs written by the systemd units (gunicorn/daphne access +
# error, celery, celerybeat) to /var/log/seals/. copytruncate is used so the
# long-running processes keep writing to the same file descriptor without a
# restart/reopen.
#
# Install: copy to /etc/logrotate.d/seals-database (root-owned, mode 0644).
# Adjust the path and the `su` user/group to match your deployment.

/var/log/seals/*.log {
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    dateext
    dateformat -%Y-%m-%d
    su seals seals
    create 0640 seals seals
}
