# Production environment for the Seals Database.
# Copy to backend/.env on the server and fill in real values. Never commit the real file.

# --- Django ---------------------------------------------------------------
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=CHANGE-ME-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
DJANGO_LANGUAGE_CODE=en-us
DJANGO_TIME_ZONE=UTC

# --- Database (Postgres) --------------------------------------------------
DATABASE_URL=postgres://seals:CHANGE-ME@127.0.0.1:5432/seals

# --- Cache / Redis --------------------------------------------------------
USE_REDIS_CACHE=True
REDIS_URL=redis://127.0.0.1:6379/0

# --- Email (SMTP relay: Brevo / Postmark / SES) ---------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_HOST_USER=CHANGE-ME
EMAIL_HOST_PASSWORD=CHANGE-ME
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com

# --- Auth / allauth -------------------------------------------------------
DJANGO_SITE_ID=1
TRANSACTIONAL_FROM_EMAIL=noreply@example.com
MARKETING_FROM_EMAIL=news@example.com
# Social login (set both id + secret to enable a provider):
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_SECRET=
APPLE_CLIENT_ID=
APPLE_SECRET=
APPLE_KEY_ID=
APPLE_CERTIFICATE_KEY=

# --- Billing (Stripe) -----------------------------------------------------
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TAX_ENABLED=True
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# --- Security -------------------------------------------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# --- Deployment -----------------------------------------------------------
HEALTHCHECK_URL=https://example.com/readyz
# SENTRY_DSN=
