[Unit]
Description=Seals Database - Gunicorn WSGI server
After=network.target postgresql.service redis.service
Wants=redis.service

[Service]
Type=simple
User=seals
Group=seals
WorkingDirectory=/opt/seals-database/backend
EnvironmentFile=/opt/seals-database/backend/.env

ExecStart=/opt/seals-database/venv/bin/gunicorn \
    --bind 127.0.0.1:8000 \
    --workers 3 \
    --graceful-timeout 30 \
    --timeout 60 \
    --access-logfile /var/log/seals/access.log \
    --error-logfile /var/log/seals/error.log \
    core.wsgi:application

Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=30

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/seals-database/backend /var/log/seals

[Install]
WantedBy=multi-user.target
