[Unit]
Description=SaaS Boilerplate - Celery worker
After=network.target redis.service postgresql.service
Requires=redis.service

[Service]
Type=simple
User=saas
Group=saas
WorkingDirectory=/opt/saas-boilerplate/backend
EnvironmentFile=/opt/saas-boilerplate/backend/.env

ExecStart=/opt/saas-boilerplate/venv/bin/celery -A core worker \
    --loglevel=info \
    --logfile=/var/log/saas/celery.log

Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=60

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/saas-boilerplate/backend /var/log/saas

[Install]
WantedBy=multi-user.target
