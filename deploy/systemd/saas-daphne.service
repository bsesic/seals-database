[Unit]
Description=SaaS Boilerplate - Daphne ASGI server (use instead of gunicorn for WebSockets/Channels)
After=network.target postgresql.service redis.service
Wants=redis.service

[Service]
Type=simple
User=saas
Group=saas
WorkingDirectory=/opt/saas-boilerplate/backend
EnvironmentFile=/opt/saas-boilerplate/backend/.env

ExecStart=/opt/saas-boilerplate/venv/bin/daphne \
    -b 127.0.0.1 \
    -p 8000 \
    --access-log /var/log/saas/access.log \
    core.asgi:application

Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=30

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/saas-boilerplate/backend /var/log/saas

[Install]
WantedBy=multi-user.target
