[Unit]
Description=Seals Database - DB + media + .env backup
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=seals
Group=seals
ExecStart=/usr/local/bin/seals-backup.sh
Nice=15
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal
SyslogIdentifier=seals-backup
